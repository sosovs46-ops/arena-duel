rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Temporary public write rule for game results.
    // Before production, replace this with authenticated Telegram/Firebase users.
    match /journal/{entryId} {
      allow create: if request.resource.data.keys().hasAll([
        'student', 'subject', 'class', 'result', 'timestamp'
      ]);
      allow read: if false;
      allow update, delete: if false;
    }

    // Teacher accounts must not store plaintext PINs in a public client.
    match /teachers/{teacherId} {
      allow read, write: if false;
    }
  }
}
